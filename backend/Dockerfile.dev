# Development Dockerfile for SentinelExam Backend
# Provides Go runtime, build tools, and live-reload / testing environment.

FROM golang:1.22-alpine

WORKDIR /app

# Install git, curl, and build tools for testing/compilation
RUN apk add --no-cache git curl build-base

# Pre-copy dependency manifests for layer caching
COPY go.mod go.sum* ./
RUN if [ -f go.mod ]; then go mod download; fi

# Expose HTTP API port
EXPOSE 8080

# Default command runs the REST API
CMD ["go", "run", "./cmd/api"]
