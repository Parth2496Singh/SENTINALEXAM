# -----------------------------------------------------------------------------
# SentinelExam Environment Configuration
# -----------------------------------------------------------------------------

# Platform
ENVIRONMENT=development
LOG_LEVEL=debug

# Backend Service
HTTP_PORT=8080
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sentinel
DATABASE_PASSWORD=sentinel_dev_password
DATABASE_NAME=sentinelexam
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=sentinel-cluster
NATS_MAX_RECONNECTS=10
NATS_RECONNECT_WAIT=2s

# Temporal Workflow Engine
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# Keycloak Identity & Access Management
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-api
KEYCLOAK_CLIENT_SECRET=sentinel-client-secret
KEYCLOAK_ISSUER=http://localhost:8081/realms/sentinel
KEYCLOAK_AUDIENCE=sentinel-api
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sentinel-backend
METRICS_PORT=9090

# Toxiproxy (Chaos / Network Emulation)
TOXIPROXY_ADDR=localhost:8474

# Frontend Environment Variables (Vite prefix)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=sentinel
VITE_KEYCLOAK_CLIENT_ID=sentinel-frontend
